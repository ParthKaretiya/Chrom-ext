{
  "manifest_version": 3,
  "name": "WhatsApp Area Blur",
  "version": "1.0.0",
  "description": "Select any area on WhatsApp Web and blur, hide, or clear it.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_title": "WhatsApp Area Blur",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}